rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /memos/{memoId} {
      // 1. 읽기: 누구나 읽을 수 있음
      allow read: if true;

      // 2. 생성:
      // - 로그인한 사용자(Google 교사 또는 익명 학생)
      // - 내용이 5글자 이상
      // - 본인 uid 및 역할(rid)이 'teacher' 또는 'student'로 올바르게 지정된 경우
      allow create: if request.auth != null
                    && request.resource.data.text is string 
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rid in ['teacher', 'student'];

      // 3. 수정: 임의 내용 변조 방지 (수정 불가)
      allow update: if false;

      // 4. 삭제:
      // - 교사(Google 로그인): 모든 메모 삭제 가능 (관리 권한)
      // - 학생(익명 사용자): 본인이 작성한 메모만 삭제 가능 (다른 사람 메모 삭제 불가)
      // - 레거시 메모(uid 없음)는 정리 허용
      allow delete: if request.auth != null && (
        request.auth.token.firebase.sign_in_provider == 'google.com'
        || resource.data.uid == request.auth.uid
        || resource.data.uid == null
      );
    }
  }
}
